    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "@shopify/polaris": "^13.9.0",
    "@shopify/shopify-api": "11.14.1",
    "@shopify/shopify-app-remix": "3.8.1",
    "@shopify/shopify-app-session-storage-prisma": "5.2.3",
    "@winback/config": "workspace:*",
    "@winback/contracts": "workspace:*",
    "@winback/crypto": "workspace:*",
    "@winback/db": "workspace:*",
    "@winback/errors": "workspace:*",
    "@winback/logger": "workspace:*",
    "@winback/shopify": "workspace:*",
    "ioredis": "5.10.1",
    "isbot": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "msw": "^2.15.0",
    "vite": "^5.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "2.1.9"
  }
