// =============================================================================
// AI Customer Winback — Database Schema (B1, version 2)
// =============================================================================
//
// Revision history:
//   v1   — initial draft (CP-1 candidate).
//   v2.2 — third-round review resolutions:
//          · aiTone enforcement strategy committed: DB CHECK floor (T5) +
//            zod schema in @winback/contracts + typed repository chokepoint.
//            Documented in field comment and header T5 entry.
//          · Migration file separation policy committed in B2 plan (one
//            auto-generated migration; T1–T5 as separate hand-authored
//            migrations).
//          · ProductVariant.inventoryQuantity confirmed at line 450.
//          · db:reset safeguard scope committed in B2 plan.
//   v2.1 — second-round review fixes:
//          · OrderLineItem.merchantId is now a proper FK with Cascade
//            (was a non-FK String — DB-enforced tenant safety > redundant
//            cascade aesthetics).
//          · BillingSubscription.onHoldReason → BillingHoldReason enum.
//          · MerchantSettings.aiToneOverride String → aiTone Json? with
//            documented shape.
//          · Soft-delete enforcement explicitly relocated from
//            "repository auto-filters" (comment-contract) to a Prisma
//            Client Extension in B3 — single point of enforcement.
//          · T1 raw-SQL spelled out (composite functional + partial
//            index, exact CREATE INDEX statement below).
//          · Cascade policy header covers all v2.1 tables explicitly.
//   v2   — incorporated CP-1 review feedback:
//         · Field-level encryption on Session.accessToken (header-doc only;
//           ciphertext fits the existing String column).
//         · Dropped Customer.emailLower; functional index lower(email) added
//           in B2 raw SQL; B3 provides typed findByEmail helper.
//         · CustomerState made orthogonal to isVip (was conflated).
//         · WebhookLog payload offloadable to object storage via
//           payload / payloadUrl / payloadSize columns; C3 policy decides
//           inline vs offload at ingestion (default threshold 50 KB).
//         · OutboxEvent.type kept as String; check constraint + TS-typed
//           registry layer enforce format (B2 + @winback/contracts).
//         · ProductVariant model added (customers buy variants, not products).
//         · OrderFinancialStatus / OrderFulfillmentStatus / ProductStatus
//           enumerated.
//         · Customer.totalSpentCents dropped (multi-currency makes it
//           semantically meaningless; per-currency rollups in Epic H).
//         · ordersCount kept and explicitly framed as Shopify cache.
//         · Merchant.shopifyPlan, shopDetailsFetchedAt added.
//         · Session @@index([expires]) added.
//         · OrderLineItem.merchantId denormalized; product/variant FKs split.
//         · Soft-delete (deletedAt) added on Customer, Product, ProductVariant.
//         · Indexes added: WebhookLog(status, receivedAt),
//                          Customer(merchantId, acceptsMarketing),
//                          Order(merchantId, financialStatus).
//         · MerchantSettings, BillingSubscription, AuditLog tables added.
//
// CONVENTIONS — UNCHANGED from v1:
//   Multi-tenancy: every business table carries merchantId; composite
//     uniques (merchantId, shopifyXxxId); FKs never cross tenants.
//   Money: BigInt cents only. Currency: ISO 4217 Char(3). Multi-currency
//     handled per-order (presentmentCurrency) and per-currency at the
//     rollup layer (Epic H) — never cumulative on Customer.
//   Time: UTC always. Merchant-local windows use Merchant.timezone at
//     query time.
//   IDs: internal PKs are cuid() strings. External Shopify IDs are String
//     and store the FULL GID (e.g. "gid://shopify/Customer/12345"), NOT
//     the numeric portion alone. Reasons: (1) modern Admin GraphQL takes
//     `ID!` (GIDs) so storing GIDs avoids reconstruction at every call
//     site; (2) the numeric is ambiguous across resources, the GID
//     disambiguates. Webhook drainers MUST wrap numeric webhook payload
//     IDs into full GIDs before upsert — see `toShopifyCustomerGid` (and
//     its four siblings: Order, Product, ProductVariant, LineItem) in
//     @winback/shopify (the helpers live in `packages/shopify/src/gid.ts`).
//     Session.userId is BigInt (forced by the
//     Shopify session adapter; not our choice).
//   Cascade policy (every FK explicitly accounted for):
//     Merchant → Customer            : CASCADE   (GDPR right-to-erasure)
//     Merchant → CustomerScore       : CASCADE   (tenant data; session 2)
//     Customer → CustomerScore       : CASCADE   (score meaningless without
//                                                 customer; GDPR redact path)
//     Merchant → Order               : CASCADE
//     Merchant → Product             : CASCADE
//     Merchant → ProductVariant      : CASCADE
//     Merchant → OrderLineItem       : CASCADE   (direct FK; transitively
//                                                 also via Order — Postgres
//                                                 handles this correctly)
//     Merchant → MerchantSettings    : CASCADE   (operational config)
//     Merchant → BillingSubscription : CASCADE   (operational; no retention)
//     Merchant → OutboxEvent         : CASCADE
//     Merchant → IdempotencyKey      : CASCADE
//     Merchant → WebhookLog          : SetNull   (forensic survival)
//     Merchant → AuditLog            : SetNull   (compliance evidence)
//     Order    → OrderLineItem       : CASCADE
//     Product  → ProductVariant      : CASCADE
//     Customer → Order               : SetNull   (severs personal link;
//                                                 preserves merchant revenue
//                                                 history)
//     Product  → OrderLineItem       : SetNull   (product gone but line item
//                                                 retained for revenue)
//     ProductVariant → OrderLineItem : SetNull
//     Merchant → AiGeneration        : CASCADE   (Epic F; tenant data)
//     Merchant → Message             : CASCADE   (Epic F; tenant data — G extends
//                                                 with Campaign/WorkflowStepExec FKs)
//     Merchant → AiSpendBucket       : CASCADE   (Epic F; platform-internal cost
//                                                 ledger; no PII)
//     Customer → AiGeneration        : CASCADE   (Epic F; generated text references
//                                                 customer PII — GDPR redact propagates)
//     Customer → Message             : CASCADE   (Epic F; generatedText denormalised
//                                                 from AiGeneration — same GDPR rationale)
//     AiGeneration → Message         : CASCADE   (Epic F; 1:1 ownership — generation
//                                                 deletion removes its draft Message)
//
// ENCRYPTION
//   Session.accessToken stores AES-256-GCM CIPHERTEXT (not plaintext).
//   Encryption wrapper around the Shopify session adapter lives in
//   @winback/crypto (M2, alongside C1). Never log this column.
//   Customer email/phone are NOT field-encrypted (queryable); disk-level
//   encryption from the managed Postgres provider is the protection.
//
// SOFT-DELETE
//   Customer / Product / ProductVariant carry deletedAt. Order has no
//   deletedAt (orders are immutable; cancel/refund are status changes).
//
//   Enforcement is NOT a repository convention. A Prisma Client Extension
//   (B3 — packages/db/src/extensions/soft-delete.ts) intercepts every
//   `findMany | findFirst | findUnique | count | aggregate` on these
//   models and injects `where: { deletedAt: null }`. The extension is the
//   single point of enforcement. Application code that needs to read
//   deleted rows must opt in explicitly with `deletedAt: { not: null }`
//   — which surfaces at call sites for code review.
//
//   This replaces the "repository must remember to filter" pattern, which
//   is exactly the kind of comment-contract that gets violated at 2 a.m.
//
// RAW-SQL ADDITIONS (B2 hard tasks, exact SQL pinned):
//
//   T1 — Composite functional + partial index for case-insensitive customer
//        email lookup. Composite (merchantId, lower(email)) so the planner
//        uses it for `WHERE merchantId = $1 AND lower(email) = lower($2)`;
//        partial WHERE deletedAt IS NULL so deleted rows don't bloat the
//        index AND the predicate matches what the Prisma soft-delete
//        extension actually queries.
//
//          CREATE INDEX customer_merchant_email_lower
//            ON "Customer" ("merchantId", lower(email))
//            WHERE "deletedAt" IS NULL;
//
//   T2 — Partial index on outbox drain path. SUPERSEDED at D4: the
//        original T2 index `outbox_unprocessed_created_at` is dropped in
//        migration 20260516130200_drop_outbox_unprocessed_idx and
//        replaced by `outbox_claimable_created_at` (created in migration
//        20260516130100_add_outbox_claimable_idx). The D4 predicate adds
//        `deadLetteredAt IS NULL` so dead-lettered rows don't bloat the
//        active claim path:
//
//          CREATE INDEX outbox_claimable_created_at
//            ON "OutboxEvent" ("createdAt")
//            WHERE "processedAt" IS NULL AND "deadLetteredAt" IS NULL;
//
//   T3 — GIN index for tag membership queries on Customer:
//
//          CREATE INDEX customer_tags_gin
//            ON "Customer" USING GIN (tags);
//
//   T4 — Check constraint enforcing OutboxEvent.type format. Combined with
//        the TS-typed event-name registry in @winback/contracts, this gives
//        defense in depth:
//
//          ALTER TABLE "OutboxEvent"
//            ADD CONSTRAINT outbox_event_type_format
//            CHECK (type ~ '^[a-z][a-z_]*\.[a-z][a-z_0-9]*(@v[0-9]+)?$');
//
//   T5 — Structural floor for MerchantSettings.aiTone (Json column). DB
//        rejects anything that isn't NULL or a Json object. Detailed shape
//        validation (enum values for `style`, length bounds, etc.) lives
//        in @winback/contracts' AiTone zod schema, enforced at the
//        repository write boundary in B3. Two-layer defense: DB owns the
//        floor, application owns the shape.
//
//          ALTER TABLE "MerchantSettings"
//            ADD CONSTRAINT merchant_settings_ai_tone_shape
//            CHECK ("aiTone" IS NULL OR jsonb_typeof("aiTone") = 'object');
//
// RESERVED FOR LATER SUBSYSTEMS (additive; no churn to v2 tables):
//   Epic E: CLOSED — CustomerScore + state machine + outbox producer +
//           UI all shipped in session 2 + the UI session.  Originally
//           also listed Segment / SegmentMembership; those moved to
//           Epic G below because campaign-audience-building is the
//           consumer of segments, not RFM scoring.
//   Epic F: AiGeneration, AiSpendBucket, Message (minimal — G extends
//           with Campaign/WorkflowStepExecution FKs + extends
//           MessageStatus enum via ALTER TYPE ADD VALUE).  Ships in
//           F batch 1 alongside EPIC-F-DESIGN.md.
//   Epic G: Segment, SegmentMembership, Suppression, Workflow,
//           WorkflowExecution, WorkflowStepExecution, Campaign,
//           CampaignTarget, MessageEvent, MessageQuotaBucket
//   Epic H: AttributionEvent, AttributionWindow, MetricsDailyRollup,
//           CustomerCurrencyTotal
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Tenant
// =============================================================================

model Merchant {
  id            String  @id @default(cuid())
  shop          String  @unique // "foo.myshopify.com"
  shopifyShopId String? @unique

  email       String?
  name        String?
  country     String? @db.Char(2)
  // Store's default currency. NOT used to denormalize aggregate totals —
  // multi-currency stores carry presentment fields on Order; per-currency
  // rollups live in Epic H.
  currency    String? @db.Char(3)
  // IANA tz (e.g. "America/Los_Angeles"). Used for all merchant-local
  // window computations (dormancy, send-time scheduling).
  timezone    String?
  // Documented values: "basic" | "shopify" | "advanced" | "plus" |
  // "partner_test" | "affiliate". Kept String, not enum, because Shopify
  // adds tiers without notice. Repository wraps with a typed accessor.
  shopifyPlan String?

  // null  → shop details have not been fetched yet (just installed).
  // set   → fetched once; null name/email mean Shopify returned them null.
  // Lets the health check distinguish "not yet" from "permanently null".
  shopDetailsFetchedAt DateTime?

  installedAt    DateTime  @default(now())
  uninstalledAt  DateTime?
  // Set when a 401 from the Admin API indicates the offline token was
  // revoked (merchant removed app from another device, etc.). Pauses all
  // workers for this merchant until re-auth.
  tokenRevokedAt DateTime?

  // First-pass state-transition suppression (Lock V10 / POST-EPIC-F §1).
  //   null → the merchant's INITIAL scoring pass has not completed. The
  //          scoring service still writes CustomerScore + Customer.state,
  //          but SUPPRESSES customer.state_changed emission (initial band
  //          assignments are not real transitions — prevents the install-day
  //          winback storm). Set by the bulk-rescore pass (A1b) in the same
  //          tx as its final batch.
  //   set  → steady state; recompute emits transitions normally.
  // See ARCHITECTURE.md "Customer State Single-Owner Policy" (lock #22 / C9).
  scoringInitializedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  customers           Customer[]
  customerScores      CustomerScore[]
  orders              Order[]
  orderLineItems      OrderLineItem[]
  products            Product[]
  productVariants     ProductVariant[]
  webhookLogs         WebhookLog[]
  outboxEvents        OutboxEvent[]
  idempotencyKeys     IdempotencyKey[]
  auditLogs           AuditLog[]
  backfillJobs        BackfillJob[]
  // Epic F — AI generation pipeline.
  aiGenerations       AiGeneration[]
  messages            Message[]
  aiSpendBuckets      AiSpendBucket[]
  settings            MerchantSettings?
  billingSubscription BillingSubscription?

  @@index([uninstalledAt]) // cron: hard-delete after retention
  @@index([tokenRevokedAt]) // cron: surface re-auth prompts
}

// =============================================================================
// Merchant configuration
//
// Separated from Merchant so settings additions don't churn the core tenant
// table. 1:1 row; created with defaults during install.
// =============================================================================

model MerchantSettings {
  id         String   @id @default(cuid())
  merchantId String   @unique
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // Attribution (Epic H)
  attributionDirectWindowDays   Int @default(14)
  attributionAssistedWindowDays Int @default(30)

  // Send-time policy (Epic G), in merchant tz
  sendTimeStartHour        Int @default(9)
  sendTimeEndHour          Int @default(18)
  defaultCooldownHours     Int @default(168) // 1 week
  maxDailySendsPerCustomer Int @default(1)

  // Cost / volume ceilings — ENFORCED from M6/M7, not deferred to M10.
  // Defaults are conservative; merchants raise via onboarding/settings UI.
  monthlyAiSpendCapCents BigInt @default(50000) // $500/mo
  monthlySendsCap        Int    @default(1000)

  // A2 / POST-EPIC-F §2 — per-merchant hourly AI generation cap.
  // Burst-starvation defence: a single merchant with daily Black-Friday-
  // scale state-change volume would monopolize the AI Worker under Epic
  // F's per-merchant concurrency=1 without this. Enforced in
  // `handleCustomerStateChanged` BEFORE the spend-cap check (cheap
  // Redis-INCR rejection before any DB write). Cap-hit → ai.rate_limited
  // AuditLog row, NO AiGeneration created. Implementation note in
  // POST-EPIC-F-CONSCIOUS-DECISION.md §2.
  hourlyGenerationCap    Int    @default(100)

  // Structured tone configuration merged into AI prompts (Epic F).
  // Shape (matches the enforced `aiToneSchema` Zod in
  // `@winback/contracts/src/ai-tone.ts` — see that file for the source of
  // truth). Comment kept in sync with the Zod schema; divergence between
  // the two is a bug (escalated and resolved 2026-05-21 in Epic F batch 2).
  //
  //   {
  //     "style":             "formal" | "casual" | "playful" | "professional",  // required
  //     "avoid":             string[],                                          // required (defaults to []), each item 1–100 chars, max 50 items
  //     "emphasize":         string[],                                          // required (defaults to []), each item 1–100 chars, max 50 items
  //     "emojiPolicy":       "none" | "minimal" | "liberal",                    // required (defaults to "minimal")
  //     "brandVoiceSample":  string                                             // OPTIONAL — max 2000 chars
  //     "customInstructions": string                                            // OPTIONAL — max 2000 chars
  //   }
  //
  // Enforcement (two-layer; see also T5 in header):
  //   · DB CHECK (T5): rejects non-object Json. Structural floor only.
  //   · Repository chokepoint: MerchantSettingsRepository.update() in
  //     @winback/db accepts a typed `AiTone` parameter, NOT raw Json. The
  //     typed parameter is parsed/validated by @winback/contracts' zod
  //     schema. Reads use `parseAiTone(unknown): AiTone | null` from
  //     `@winback/contracts` — null when the column is null, throws ZodError
  //     on malformed JSON. There is no untyped write path.
  aiTone Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// =============================================================================
// Billing
//
// Placeholder for Shopify Billing API integration in M10. Created during
// install with status=trialing.
// =============================================================================

enum BillingSubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  paused
}

enum BillingHoldReason {
  shop_on_hold // Shopify reported the shop itself is on hold
  payment_failed // Recurring charge attempt failed
  plan_change // Mid-transition between plans
  manual_pause // Operator intervention
  fraud_review // Internal review
}

model BillingSubscription {
  id         String   @id @default(cuid())
  merchantId String   @unique
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  shopifyChargeId       String? // Shopify Recurring/Application Charge ID
  status                BillingSubscriptionStatus @default(trialing)
  plan                  String? // internal plan identifier
  trialEndsAt           DateTime?
  currentPeriodStartsAt DateTime?
  currentPeriodEndsAt   DateTime?

  // Operator-set hold (payment failed, manual intervention, etc.)
  onHoldReason BillingHoldReason?
  onHoldAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([currentPeriodEndsAt])
}

// =============================================================================
// Shopify Session
//
// Matches @shopify/shopify-app-session-storage-prisma. `accessToken` is
// AES-256-GCM CIPHERTEXT — encryption wraps the official adapter (M2).
// Never log this column, never expose it via any API.
// =============================================================================

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String // CIPHERTEXT — see header
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  @@index([shop])
  @@index([expires]) // cleanup cron
}

// =============================================================================
// Customer
//
// `state` (lifecycle) and `isVip` (value) are ORTHOGONAL dimensions:
//   (state=at_risk, isVip=true)   → high-value customer trending to churn
//                                    (the highest-priority retention target)
//   (state=dormant, isVip=false)  → low-value lapsed customer
//
// `ordersCount` is a cache from Shopify's customer payload — we copy it on
// every customers/update webhook. Never computed locally; never used as
// source of truth.
//
// Case-insensitive email lookup is served by a functional index lower(email)
// added via raw SQL in B2 (T1). No emailLower column.
// =============================================================================

enum CustomerState {
  active
  warm
  at_risk
  dormant
  lost
  // Added in Epic E session 2. Assigned when the merchant's scorable
  // cohort has fewer than 5 customers with paid orders in the trailing
  // 365d window — quintile boundaries can't be meaningfully computed.
  // See EPIC-E-SESSION-2-DESIGN.md §S-4, §S-5.
  insufficient_data
}

model Customer {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  shopifyCustomerId String

  email     String?
  phone     String?
  firstName String?
  lastName  String?

  acceptsMarketing Boolean @default(false)
  acceptsSms       Boolean @default(false)

  // Cached from Shopify customers payload (NOT computed locally).
  ordersCount Int @default(0)

  firstOrderAt DateTime?
  lastOrderAt  DateTime?

  state CustomerState @default(active)
  isVip Boolean       @default(false)

  tags String[] @default([]) // GIN index via raw SQL (T3)

  shopifyCreatedAt DateTime?
  shopifyUpdatedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  // Set when Shopify reports the customer gone (404 on resync) or when
  // a customers/redact GDPR webhook fires. Repository auto-filters.
  deletedAt DateTime?

  orders        Order[]
  // 1:1 with the per-customer RFM score row written by Epic E session 2's
  // scoring service. Nullable on the relation side because lurkers without
  // a recompute pass yet have no row; once `customerScoreService.recompute`
  // runs, every Customer has exactly one CustomerScore.
  customerScore CustomerScore?
  // Epic F — AI generation pipeline. One row per LLM call triggered by a
  // state transition; one minimal Message draft row per generation.
  aiGenerations AiGeneration[]
  messages      Message[]

  @@unique([merchantId, shopifyCustomerId])
  @@index([merchantId, state])
  @@index([merchantId, lastOrderAt])
  @@index([merchantId, acceptsMarketing]) // hot path: campaign audience build
  @@index([merchantId, isVip])
}

// =============================================================================
// Customer score (Epic E session 2)
//
// Per-customer RFM aggregates + quintile scoring + churn risk. One row per
// Customer (single-row scheme — Q3 lock). History lives in `AuditLog` rows
// (action `customer.state_changed`) and `OutboxEvent` rows of the same name.
//
// Recompute is inline in the drainer's order + customer upsert handlers,
// SAME transaction as the business write. Reads the merchant's scorable
// cohort live via raw-SQL aggregation against `Order` (NOT against
// CustomerScore — that would be circular). See EPIC-E-SESSION-2-DESIGN.md
// §S-1 through §S-11 for the full contract.
//
// All quintile + churn columns are nullable: lurkers and members of an
// `insufficient_data` cohort (<5 scorable customers) get a row with raw R/F/M
// values but null quintiles (§S-4, §S-6).
//
// `churnRiskScore` is Float8 (`@db.DoublePrecision`), not Float4, so the
// 0.0–1.0 range has full mantissa precision. Per-row revenue decisions
// downstream (Epic G/F) deserve the precision; Float4 (Postgres default for
// `Float`) loses past ~7 significant digits.
//
// Cascade policy:
//   Merchant → CustomerScore : CASCADE (tenant data; GDPR right-to-erasure)
//   Customer → CustomerScore : CASCADE (score has no meaning without its
//                                       customer; GDPR redact propagates)
// =============================================================================

model CustomerScore {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // `@unique` here (not composite `@@unique([merchantId, customerId])`)
  // because cuid PKs are globally unique — adding merchantId to the index
  // doesn't change the uniqueness invariant, and Prisma's 1:1 relation
  // parser requires a field-level @unique on the referencing side.
  // Tenant safety on cross-tenant CustomerScore writes is enforced by the
  // tenant-scope Prisma extension at the query layer, same as Order.customerId.
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // RFM raw values (always populated)
  rDays    Int // Days since last paid order; account-age fallback for lurkers (§S-6).
  fCount   Int // Paid, non-test orders in trailing 365d.
  mCents   BigInt // SUM(Order.totalAmountCents) in trailing 365d. Shop currency.
  currency String @db.Char(3) // Snapshot of Merchant.shopCurrency at computedAt (§S-11).

  // RFM quintiles — null for lurkers and insufficient_data cohorts (§S-4, §S-6)
  rQuintile      Int?
  fQuintile      Int?
  mQuintile      Int?
  // 0.0 = best (lowest churn risk), 1.0 = worst. Derived from quintiles.
  // Null whenever any quintile is null. Float8 / double precision per above.
  churnRiskScore Float? @db.DoublePrecision

  computedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  // Dashboard query: "show me my top at-risk customers." DESC sort is
  // pre-baked into the index so the planner avoids a separate sort step.
  @@index([merchantId, churnRiskScore(sort: Desc)])
  // Staleness scans for the future operator bulk-rescore command (§S-9).
  @@index([merchantId, computedAt])
}

// =============================================================================
// Product / ProductVariant
//
// Customers buy variants. OrderLineItem links to ProductVariant for
// replenishment-interval scoring (E5) and per-variant pricing history.
// =============================================================================

enum ProductStatus {
  active
  draft
  archived
}

model Product {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  shopifyProductId String

  title       String
  productType String?
  vendor      String?
  status      ProductStatus @default(active)

  shopifyCreatedAt DateTime?
  shopifyUpdatedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  variants  ProductVariant[]
  lineItems OrderLineItem[]

  @@unique([merchantId, shopifyProductId])
  @@index([merchantId, productType]) // category affinity
  @@index([merchantId, status])
}

model ProductVariant {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  shopifyVariantId String

  sku   String?
  title String

  priceCents          BigInt
  compareAtPriceCents BigInt?
  currency            String  @db.Char(3)

  inventoryQuantity Int?

  shopifyCreatedAt DateTime?
  shopifyUpdatedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  lineItems OrderLineItem[]

  @@unique([merchantId, shopifyVariantId])
  @@index([productId])
  @@index([merchantId, sku])
}

// =============================================================================
// Order
// =============================================================================

enum OrderFinancialStatus {
  pending
  authorized
  partially_paid
  paid
  partially_refunded
  refunded
  voided
}

enum OrderFulfillmentStatus {
  fulfilled
  partial
  unfulfilled
  restocked
}

model Order {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  customerId String?
  // SetNull (not Cascade) so GDPR customer purge severs the personal link
  // but preserves merchant revenue history.
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  shopifyOrderId     String
  shopifyOrderNumber String?

  totalAmountCents    BigInt
  subtotalAmountCents BigInt
  totalTaxCents       BigInt @default(0)
  totalDiscountCents  BigInt @default(0)
  currency            String @db.Char(3)

  presentmentCurrency   String? @db.Char(3)
  presentmentTotalCents BigInt?

  financialStatus   OrderFinancialStatus?
  fulfillmentStatus OrderFulfillmentStatus?

  // Set when Shopify's `test: true` is on the webhook payload. Merchants'
  // dev-store test orders would otherwise inflate RFM frequency scores;
  // Epic E session 2's scoring query filters `WHERE isTest = false`.
  // See EPIC-E-FIELD-MAPPING.md row #81.
  isTest Boolean @default(false)

  // `placedAt` is when the customer placed the order (Shopify created_at).
  // Replaces a redundant shopifyCreatedAt column; the business name is the
  // useful one.
  placedAt    DateTime
  cancelledAt DateTime?

  // Shopify's `processed_at` — the customer-visible order date used by
  // Shopify analytics. Distinct from `placedAt` (= Shopify created_at)
  // for draft orders converted to real orders later. Epic E session 2's
  // RFM recency axis reads `shopifyProcessedAt ?? placedAt`. Nullable
  // because Shopify doesn't always populate it on synchronous checkouts.
  // See EPIC-E-FIELD-MAPPING.md row #6.
  shopifyProcessedAt DateTime?

  shopifyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  lineItems OrderLineItem[]

  @@unique([merchantId, shopifyOrderId])
  @@index([merchantId, customerId])
  @@index([merchantId, placedAt])
  @@index([merchantId, financialStatus]) // attribution & revenue rollups
}

model OrderLineItem {
  id         String   @id @default(cuid())
  // Proper FK to Merchant. Postgres handles the transitive cascade path
  // (Merchant → Order → OrderLineItem AND Merchant → OrderLineItem) just
  // fine — the row is deleted exactly once. The point is DB-ENFORCED tenant
  // safety: a junior dev cannot accidentally write the wrong merchantId
  // here, because the FK constraint will reject it.
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  shopifyLineItemId String

  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  title          String
  quantity       Int
  unitPriceCents BigInt
  currency       String @db.Char(3)

  createdAt DateTime @default(now())

  // S-4: merchantId-prefixed so the Prisma extension's findUnique-skip
  // path can't be exploited by a caller outside the active tenant scope.
  // Behaviorally identical for uniqueness (orderId→merchantId is 1:1 via
  // FK); structurally consistent with the rest of the schema's tenant-
  // scoped composite uniques.  See POINTS-TO-CONSIDER S-4 entry.
  @@unique([merchantId, orderId, shopifyLineItemId])
  @@index([merchantId, productId])
  @@index([productVariantId])
}

// =============================================================================
// Webhook log
//
// To bound storage at scale, payloads larger than INLINE_LIMIT_BYTES (50 KB
// default) are offloaded to object storage and referenced via payloadUrl.
// Both payload and payloadUrl are nullable; payloadSize is the original
// byte size regardless of storage location. The choice is made by C3 at
// ingestion.
// =============================================================================

enum WebhookProcessingStatus {
  received
  processed
  failed
  skipped_duplicate
}

model WebhookLog {
  id         String    @id @default(cuid())
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  // Denormalized so logs are queryable after the merchant FK is nulled
  // (forensic survival post-merchant-deletion).
  shop       String

  topic            String
  shopifyWebhookId String?
  idempotencyKey   String?
  hmacOk           Boolean

  status       WebhookProcessingStatus @default(received)
  errorCode    String?
  errorMessage String?

  payload     Json? // stored inline when small
  payloadUrl  String? // object storage reference when offloaded
  payloadSize Int? // original size in bytes

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([merchantId, receivedAt])
  @@index([shop, receivedAt])
  @@index([topic, receivedAt])
  @@index([status, receivedAt]) // monitoring + retry workers
  @@index([idempotencyKey])
}

// =============================================================================
// Outbox
//
// Domain events written in the SAME DB transaction as the business write
// that produced them. A worker drains the outbox into BullMQ (D2). This
// eliminates dual-write inconsistency between DB and queue.
//
// `type` is a String, but format is enforced by:
//   (a) a B2 CHECK constraint matching ^[a-z][a-z_]*\.[a-z][a-z_0-9]*(?:@v\d+)?$
//   (b) a TS-typed event-name registry in @winback/contracts — producers
//       reference registry constants, not string literals.
//
// Partial index WHERE processedAt IS NULL added in B2 (T2); the standard
// composite index here is a fallback until partition / partial lands.
// =============================================================================

model OutboxEvent {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  type    String // see header for validation strategy
  payload Json

  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  // D4 DLQ. Set when the drainer gives up on a row (either non-retryable
  // error per @winback/errors `isRetryable`, or `attempts + 1 >=
  // MAX_OUTBOX_ATTEMPTS` after a retryable failure). Operator's `pnpm
  // cli:outbox:replay` clears this back to null to requeue the row.
  // `claimBatch` filters `WHERE deadLetteredAt IS NULL` so dead-lettered
  // rows are never re-claimed by the drainer.
  deadLetteredAt DateTime?

  // D4 forensic marker for MARK_BEFORE_INVOKE_EVENTS Phase 2 failures.
  // The row was marked processed in Phase 1 (correctly, per ordering
  // policy) but the deferred handler invocation in Phase 2 threw. The
  // row is logically "done" (processedAt set), but the actual work was
  // incomplete. Operator visibility only; recovery is manual replay or
  // operator intervention (the handlers are idempotent by design).
  //
  // OPERATOR RUNBOOK — surface rows needing attention:
  //   SELECT id, "merchantId", type, "deferredFailedAt", "lastError"
  //   FROM "OutboxEvent"
  //   WHERE "deferredFailedAt" IS NOT NULL
  //   ORDER BY "deferredFailedAt" DESC;
  //
  // No automatic alerting in D4 — observability is psql-driven. The
  // handlers identified by this query are gdpr.shop_redacted and
  // merchant.installed (per MARK_BEFORE_INVOKE_EVENTS). Manual
  // remediation: re-invoke the handler logic against the row's
  // merchantId. Both handlers are idempotent — re-running on a
  // partially-completed state resumes correctly.
  deferredFailedAt DateTime?

  @@index([processedAt, createdAt])
  @@index([merchantId, type, createdAt])
}

// =============================================================================
// Idempotency keys
//
// Composite PK (merchantId, key). Key format conventions:
//   webhook ingestion: "<topic>:<X-Shopify-Webhook-Id>"
//                  or  "<topic>:<resourceId>:<shopifyUpdatedAt>"
//   send pipeline:     "send:<campaignId>:<customerId>:<stepId>"
//
// `expiresAt` indexed for cron-driven cleanup (D3). Typical TTL: 7d
// (webhook dedup window) or 30d (send pipeline keys).
// =============================================================================

model IdempotencyKey {
  key        String
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@id([merchantId, key])
  @@index([expiresAt])
}

// =============================================================================
// Audit log
//
// Append-only record of sensitive operations: GDPR redactions, merchant
// uninstalls, operator interventions, billing actions. Compliance evidence;
// retained through merchant deletion via SetNull + denormalized `shop`.
//
// Distinct from WebhookLog (operational debugging) and OutboxEvent
// (domain events). AuditLog is for human-readable forensics.
// =============================================================================

enum AuditActorType {
  system
  merchant
  operator
}

model AuditLog {
  id         String    @id @default(cuid())
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  shop       String?

  actorType AuditActorType
  // Operator email, merchant user id, or system component name.
  actorId   String?

  // Dotted action name. Examples:
  //   "merchant.uninstalled"
  //   "gdpr.customer_redact"
  //   "campaign.force_cancelled"
  //   "billing.subscription_paused"
  action     String
  targetType String? // "customer" | "merchant" | "campaign" | ...
  targetId   String?

  context Json?

  createdAt DateTime @default(now())

  @@index([merchantId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// =============================================================================
// Backfill jobs (C5)
//
// Tracks resumable per-resource historical pulls from Shopify. The runner
// commits each page's row writes and `cursor` update in the SAME tx; a
// crash loses at most one in-flight page, and the next run re-fetches
// from the persisted cursor (upsert idempotency handles dup writes).
//
// Cascades on Merchant delete (operational data; no compliance retention).
// =============================================================================

enum BackfillStatus {
  pending
  running
  completed
  paused
  failed
}

model BackfillJob {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // "customers" | "orders" | "products" — kept String, not enum, so adding
  // a resource (e.g. "discounts") doesn't need a DDL migration. The
  // application validates against a typed registry.
  resource String

  status         BackfillStatus @default(pending)
  // Shopify GraphQL endCursor for resume. NULL = start from beginning.
  cursor         String?
  pageSize       Int            @default(50)
  itemsProcessed Int            @default(0)
  pagesProcessed Int            @default(0)
  attempts       Int            @default(0)
  lastError      String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([merchantId, resource])
  @@index([status])
}

// =============================================================================
// AI generation pipeline (Epic F)
//
// Three additive tables backing the multi-provider LLM call site. See
// EPIC-F-DESIGN.md for the full contract (Q1–Q10 + F-1..F-12).
//
//   AiGeneration   — one row per LLM call. Pre-created (status=pending) by
//                    the `customer.state_changed` drainer handler before the
//                    BullMQ `ai.generate` job is enqueued. AI Worker mutates
//                    to completed/failed. Stores prompts + response + cost.
//                    costMicrocents is BigInt MICROCENTS (1 USD = 100_000_000)
//                    — modern LLM pricing is fractions of a cent per token.
//   Message        — minimal F-batch-1 columns only. Epic G's batch 1 ALTERs
//                    to add Campaign / WorkflowStepExecution FKs + extends
//                    MessageStatus enum via ALTER TYPE ADD VALUE (sent,
//                    suppressed, failed, bounced, opened, clicked).
//                    1:1 with AiGeneration; aiGenerationId is @unique.
//                    generatedText is denormalised from AiGeneration so G's
//                    dispatch worker reads it without a JOIN.
//   AiSpendBucket  — daily per-merchant platform LLM spend. Pre-call ceiling
//                    check sums the current calendar-month-UTC buckets vs
//                    MerchantSettings.monthlyAiSpendCapCents (cents → micro-
//                    cents at compare time). Post-call SELECT FOR UPDATE +
//                    increment serialises concurrent jobs for the same
//                    merchant per F-6.
//
// Cascade chain (GDPR-critical link is the third):
//   Merchant → AiGeneration/Message/AiSpendBucket : CASCADE
//   Customer → AiGeneration/Message               : CASCADE
//   AiGeneration → Message                        : CASCADE
//
// Customer redact fires Customer→AiGeneration:CASCADE which transitively
// removes Message via the AiGeneration→Message arrow. The direct Customer→
// Message arrow is redundant safety — same atomic DELETE statement.
//
// All three tables MUST be added to TENANT_SCOPED_MODELS in
// packages/db/src/tenant-scope.ts (locked decision #24). Without that, the
// extension passes their reads + writes through without tenant injection —
// tenant-safety bug, same class as Epic E session 2's pre-fix CustomerScore.
// =============================================================================

enum AiGenerationStatus {
  pending
  completed
  failed
}

enum MessageStatus {
  draft
  // Epic G's batch 1 extends via ALTER TYPE ADD VALUE:
  //   sent, suppressed, failed, bounced, opened, clicked
  // Postgres enum extension is non-breaking — same mechanism Epic E used
  // to add `insufficient_data` to CustomerState in session 2.
}

model AiGeneration {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Trigger context — snapshot at generation time. Future RFM recomputes
  // do NOT retroactively update these fields. Stored as String (not the
  // CustomerState enum) because EPIC-F-DESIGN.md keeps the column shape
  // resilient to future CustomerState extensions without an ALTER TABLE.
  triggerState   String
  previousState  String
  rDays          Int
  fCount         Int
  mCents         BigInt
  currency       String @db.Char(3)
  churnRiskScore Float?

  // Provider + model locked at generation time for forensics + cost
  // reconciliation. NOT a FK — provider config is platform env, not a DB
  // entity. Values: 'deepseek' | 'openai' | 'anthropic' (the union shipped
  // in `packages/ai` batch 2; not enum-constrained at the DB layer because
  // operator-led provider additions should not need DDL).
  provider String
  modelId  String

  // Prompts stored for auditability + prompt regression testing.
  systemPrompt String @db.Text
  userPrompt   String @db.Text

  // LLM response. Null until status = completed.
  generatedText String? @db.Text
  inputTokens   Int?
  outputTokens  Int?
  totalTokens   Int?
  latencyMs     Int?

  // Cost in microcents (billionths of a dollar) — BigInt for precision.
  // 1 USD = 100 cents = 100_000_000 microcents. Microcents (not cents)
  // because modern LLM pricing is in fractions of a cent per token.
  // Aggregated into cents only at the AiSpendBucket rollup layer.
  // Null until completed.
  costMicrocents BigInt?

  status    AiGenerationStatus @default(pending)
  failedAt  DateTime?
  lastError String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // 1:1 — every AiGeneration has at most one Message. Message.aiGenerationId
  // is the @unique field on the other side (same pattern as
  // CustomerScore.customerId @unique).
  message Message?

  @@index([merchantId, createdAt])
  @@index([merchantId, customerId])
  @@index([status, createdAt]) // AI Worker stale-pending scan (M10 sweep)
}

model Message {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // 1:1 with AiGeneration — every Message originates from one LLM call.
  // @unique gives the relation parser the field-level unique it needs
  // for 1:1; same convention as CustomerScore.customerId @unique. Cuid
  // is globally unique, single-column @unique is sufficient.
  aiGenerationId String       @unique
  aiGeneration   AiGeneration @relation(fields: [aiGenerationId], references: [id], onDelete: Cascade)

  // Denormalised for fast read at send time — G's dispatch worker reads
  // this without joining back to AiGeneration. Same write-side snapshot
  // pattern CP-2 §Q3 uses for `messageSentAt`.
  generatedText String @db.Text

  status MessageStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Epic G's batch 1 migration adds:
  //   campaignId String?
  //   campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  //   workflowStepExecutionId String?
  //   workflowStepExecution   WorkflowStepExecution? @relation(fields: [workflowStepExecutionId], references: [id], onDelete: SetNull)
  //   channel    MessageChannel  // enum: email, sms, whatsapp
  //   sentAt     DateTime?
  //   provider   String?         // SendGrid, Twilio, etc.
  // Documented here so F-batch-1 reviewers see the planned shape.

  @@index([merchantId, status])
  @@index([merchantId, customerId])
  @@index([merchantId, createdAt])
}

model AiSpendBucket {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // Day in UTC. Stored as UTC midnight (e.g. 2026-06-15T00:00:00Z for
  // June 15 2026 UTC). Merchant timezone is NOT used for bucket period —
  // the monthly cap is calendar-month UTC, the daily-bucket key is UTC
  // date. Operator merchant-local rollup dashboards convert at read time.
  date DateTime

  // Running total in microcents for this day. Incremented atomically
  // (SELECT FOR UPDATE on the bucket row) when each AiGeneration completes.
  spentMicrocents BigInt @default(0)

  // Generation count for this day — denormalised for cheap
  // "generations per merchant per day" observability without an
  // AiGeneration COUNT(*) scan.
  generationCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([merchantId, date])
  @@index([merchantId, date])
}
