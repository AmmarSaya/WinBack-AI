# =============================================================================
# AI Customer Winback — environment template
#
# Copy to `.env` for local dev. In dev/test, processes are launched with
# `node --env-file=.env ...` (Node 20.6+). In staging/prod, env is injected
# by the orchestrator (no .env files in those environments).
#
# Variables are validated at process boot by @winback/config. Subsystems
# append their own sections to this file as they land.
# =============================================================================

# --- Core (resolved by @winback/config) --------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Identifies the process in logs/metrics. Set per deploy unit, e.g.:
#   web                 → apps/web
#   worker.webhook      → webhook ingestion worker
#   worker.sync         → Shopify backfill / sync worker
#   worker.ai           → AI generation worker
#   worker.send         → message send worker
#   worker.scheduler    → cron / scheduler
SERVICE_NAME=web

# --- Database (resolved by @winback/db) --------------------------------------
DATABASE_URL=postgresql://winback:winback@localhost:5432/winback
# Optional: shadow DB used by `prisma migrate dev` to detect drift.
# Only needed in local development; staging/prod migrations use `migrate deploy`.
# SHADOW_DATABASE_URL=postgresql://winback:winback@localhost:5432/winback_shadow

# --- Redis (added by subsystem D1 / @winback/queue) --------------------------
# Port 6380 matches docker-compose.test.yml's Redis service mapping
# (6380:6379), so this URL works directly when running `pnpm queue:test`.
# Devs running a native Redis on the default 6379 should override locally.
# REDIS_URL=redis://localhost:6380

# --- Shopify (resolved by @winback/shopify) ----------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost:8080
SHOPIFY_SCOPES=read_customers,read_orders,read_products,read_inventory,read_price_rules,read_discounts,write_discounts,write_marketing_events,read_marketing_events
SHOPIFY_API_VERSION=2026-04
# Optional dedicated webhook secret. If unset, webhook HMAC uses the API
# secret above (Shopify default). Most apps don't need this.
# SHOPIFY_WEBHOOK_SECRET=

# --- Crypto (resolved by @winback/crypto + @winback/shopify) -----------------
# AES-256-GCM key for session-token encryption. Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation: see packages/shopify/src/config.ts header comment.
ENCRYPTION_KEY=

# --- AI providers (resolved by @winback/ai) ----------------------------------
# Active provider + model. Switching providers is a config change, never a
# code change. Lock V7 (POST-EPIC-F-CONSCIOUS-DECISION.md) freezes DeepSeek
# as the launch provider — switching production env to OpenAI / Anthropic
# requires a margin re-baseline (per the PRICING-MODEL-v1 unit econ math).
#
# Only the ACTIVE provider's API key is required at boot. `getAiConfig`
# validates the discriminated union: `AI_PROVIDER=openai` requires
# `OPENAI_API_KEY` to be set + non-empty; the other two keys can be absent.
#
# Allowed `AI_MODEL` values (per provider):
#   openai     → gpt-4.1 | gpt-4.1-mini | gpt-4.1-nano
#   anthropic  → claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5
#   deepseek   → deepseek-v4-flash | deepseek-v4-pro
#
# Deprecated strings (boot rejects with a friendly message):
#   deepseek-chat         → use deepseek-v4-flash
#   gpt-4o / gpt-4o-mini  → use gpt-4.1-mini / gpt-4.1-nano
AI_PROVIDER=deepseek
AI_MODEL=deepseek-v4-flash
AI_MAX_TOKENS=300
AI_TEMPERATURE=0.7
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=YOUR_KEY_HERE

# --- Email / SMS / WhatsApp (added by subsystem G3 / @winback/campaigns) -----
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
